# Copy these values into the server/process environment.
# Do not commit real credentials to this file or to source control.

# Database configuration
SFOF_DB_HOST=localhost
SFOF_DB_USER=root
SFOF_DB_PASSWORD=replace-with-db-password
SFOF_DB_NAME=sfofindia_db

# CodeIgniter encryption key (32 bytes random string)
SFOF_ENCRYPTION_KEY=replace-with-32-char-random-key

# SMTP email integration (PHPMailer and CodeIgniter email helper)
SFOF_SMTP_HOST=smtp.example.com
SFOF_SMTP_PORT=465
SFOF_SMTP_USER=your-mailbox@example.com
SFOF_SMTP_PASSWORD=replace-with-smtp-password
SFOF_SMTP_CRYPTO=ssl
SFOF_SMTP_FROM_EMAIL=contact@sfofindia.org
SFOF_RAZORPAY_KEY_ID=replace-with-razorpay-key-id
SFOF_RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
SFOF_RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
SFOF_BASE_URL=https://sfofindia.org/
SFOF_LOG_THRESHOLD=1
SFOF_ALLOW_RUNTIME_SCHEMA=false
# Required for the protected HTTP daily birthday/renewal scheduler.
SFOF_AUTOMATION_KEY=replace-with-long-random-automation-key
# Generate a long random value and set it only during administrator setup.
SFOF_ADMIN_SETUP_TOKEN=replace-with-long-random-setup-token

# WhatsApp Cloud API integration.
# Keep false until all values below are replaced with real provider values.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/vXX.X/PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_TEMPLATE_NAME=membership_registration
WHATSAPP_TEMPLATE_LANGUAGE=en_US
